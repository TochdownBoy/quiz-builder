{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/generated/(.*)$": "<rootDir>/../generated/$1",
    "^@/prisma\\.config$": "<rootDir>/../prisma.config.ts",
    "^@/(.*)$": "<rootDir>/../src/$1"
  }
}
